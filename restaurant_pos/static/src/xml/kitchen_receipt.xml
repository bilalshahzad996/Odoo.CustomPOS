<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="restaurant_pos.KitchenReceipt">
        <div style="font-family: monospace; width: 300px; padding: 16px; background: white; color: black;">

            <div style="text-align:center; border-bottom: 2px dashed #000; padding-bottom: 8px; margin-bottom: 10px;">
                <div style="font-size: 20px; font-weight: bold; letter-spacing: 2px;">
                    *** KITCHEN TICKET ***
                </div>
            </div>

            <table style="width:100%; font-size:13px; margin-bottom:8px;">
                <tr>
                    <td><strong>Order Type:</strong></td>
                    <td style="text-align:right;"><t t-esc="orderType"/></td>
                </tr>
                <t t-if="table">
                    <tr>
                        <td><strong>Table:</strong></td>
                        <td style="text-align:right;"><t t-esc="table"/></td>
                    </tr>
                </t>
                <tr>
                    <td><strong>Time:</strong></td>
                    <td style="text-align:right;"><t t-esc="time"/></td>
                </tr>
            </table>

            <div style="border-top: 1px dashed #000; margin: 8px 0;"/>

            <div style="font-weight: bold; font-size: 14px; margin-bottom: 8px;">
                ITEMS TO PREPARE:
            </div>

            <t t-foreach="lines" t-as="line" t-key="line_index">
                <div style="margin-bottom: 6px; font-size: 14px;">
                    <span style="font-weight: bold; font-size: 16px;">
                        <t t-esc="line.qty"/>
                    </span>
                    &#160;x&#160;
                    <span style="font-weight: bold;">
                        <t t-esc="line.name"/>
                    </span>
                    <t t-if="line.note">
                        <div style="margin-left: 24px; font-style: italic; font-size: 12px; color: #555;">
                            &#x279C; <t t-esc="line.note"/>
                        </div>
                    </t>
                </div>
            </t>

            <div style="border-top: 1px dashed #000; margin-top: 10px; padding-top: 8px; text-align: center; font-size: 11px;">
                *** KITCHEN COPY - DO NOT GIVE TO CUSTOMER ***
            </div>

        </div>
    </t>

</templates>